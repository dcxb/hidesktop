#include <windows.h>

#include "resource.h"

IDI_HIDESKTOP ICON "hidesktop.ico"
IDI_HIDESKTOP_HIDDEN ICON "hidesktop_hidden.ico"

/* asInvoker + per-monitor DPI awareness for the tray menu. */
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "hidesktop"
            VALUE "FileDescription", "Double-click the desktop to hide or show the desktop icons"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "hidesktop"
            VALUE "OriginalFilename", "hidesktop.exe"
            VALUE "ProductName", "hidesktop"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
